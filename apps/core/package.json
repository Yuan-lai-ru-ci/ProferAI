{
  "name": "@profer/core-daemon",
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "description": "Profer 的无界面、宿主无关核心进程入口。",
  "type": "module",
  "bin": {
    "profer-core": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun src/dev-core.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --outfile dist/profer-core src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@profer/core": "workspace:*",
    "@profer/agent-provider-claude": "workspace:*",
    "@profer/agent-provider-pi": "workspace:*",
    "@profer/agent-runtime": "workspace:*",
    "@profer/session-store": "workspace:*",
    "@profer/shared": "workspace:*",
    "ws": "8.21.1",
    "typebox": "1.1.38",
    "zod": "^4.0.0",
    "@earendil-works/pi-coding-agent": "0.86.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.0.0"
  }
}
