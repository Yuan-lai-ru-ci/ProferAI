{
  "schemaVersion": 1,
  "id": "com.profer.plugin-lifecycle-demo",
  "name": "插件实例生命周期验收台",
  "version": "1.0.0",
  "description": "用于验收 Tab、任务面板、工具页实例隔离，以及插件权限、请求取消、存储和 provider 错误边界。",
  "publisher": "Profer 内置验收样例",
  "permissions": [
    "pluginStorage",
    "models.read",
    "models.invoke",
    "modelRouting.rules.write",
    "context.read",
    "attachments.read",
    "network.fetch",
    "agent.tools",
    "workspace.read",
    "workspace.files.read",
    "workspace.files.write",
    "presets.read",
    "presets.switch",
    "sessions.read",
    "sessions.create",
    "sessions.configure",
    "sessions.control",
    "runtime.capabilities.read",
    "runtime.capabilities.inject",
    "secrets.readMetadata",
    "secrets.configure"
  ],
  "network": { "origins": ["https://example.com"] },
  "contributes": {
    "pages": [
      {
        "id": "lifecycle",
        "title": "插件实例验收台",
        "entry": "index.html",
        "icon": "icon.svg",
        "placements": ["settings", "tab", "sidebar"]
      }
    ],
    "modelRoutingPolicies": [
      { "id": "lifecycle-routing", "kind": "model-routing.rules.v1" }
    ],
    "messageActions": [
      { "id": "inspect-message", "title": "交给实例验收台", "pageId": "lifecycle" }
    ],
    "tools": [
      {
        "id": "instance-echo",
        "title": "实例验收：回显上下文",
        "description": "返回当前插件工具页面实例、调用参数和取消状态，用于验证工具页与交互页面隔离。",
        "pageId": "lifecycle",
        "parameters": {
          "text": { "type": "string", "description": "要回显的文本", "required": true }
        }
      },
      {
        "id": "instance-delay",
        "title": "实例验收：可取消延迟",
        "description": "等待指定秒数并监听取消，用于验证工具页面关闭和取消请求生命周期。",
        "pageId": "lifecycle",
        "parameters": {
          "seconds": { "type": "number", "description": "等待秒数，范围 1 到 30", "required": true }
        }
      }
    ]
  }
}
