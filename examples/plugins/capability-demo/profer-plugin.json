{
  "schemaVersion": 1,
  "id": "com.profer.capability-demo",
  "name": "插件能力演示",
  "version": "1.0.0",
  "description": "配置时段路由、处理当前内容、调用模型与网络，并向 Agent 提供文本工具。",
  "permissions": ["pluginStorage", "models.read", "models.invoke", "modelRouting.rules.write", "context.read", "attachments.read", "network.fetch", "agent.tools"],
  "network": { "origins": ["https://example.com"] },
  "contributes": {
    "pages": [{ "id": "main", "title": "插件工具箱", "entry": "index.html", "icon": "icon.svg", "placements": ["settings", "tab", "sidebar"] }],
    "modelRoutingPolicies": [{ "id": "time-routing", "kind": "model-routing.rules.v1" }],
    "messageActions": [{ "id": "process", "title": "交给插件工具箱", "pageId": "main" }],
    "tools": [
      { "id": "uppercase", "title": "转为大写", "description": "把用户提供的文本转换为大写。", "pageId": "main", "parameters": { "text": { "type": "string", "required": true } } },
      { "id": "summarize", "title": "总结文本", "description": "使用插件工具箱中已保存的模型总结指定文本。会产生模型用量。", "pageId": "main", "parameters": { "text": { "type": "string", "required": true } } }
    ]
  }
}
