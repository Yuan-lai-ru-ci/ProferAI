# Profer Team Server 环境变量
# 复制为 .env 并修改

# === 必填 ===
JWT_SECRET=change-me-to-a-random-64-byte-hex
ADMIN_PASSWORD=change-me-to-a-strong-password

# === 安全（生产必设）===
# ALLOWED_ORIGIN=https://your-domain.com   # CORS 允许的源；支持多个域名（逗号分隔）。未设置时拒绝浏览器跨域；开发时如确有需要请显式设为 *
# CHANNEL_ENCRYPTION_KEY=                  # 渠道 API Key 加密密钥（COMMERCIAL_MODE=true 时必填，64 位 hex）

# === 可选 ===
# PORT=3456
# ADMIN_EMAIL=admin@proma.local
# MAX_FILE_SIZE=524288000
# MAX_BODY_SIZE=52428800        # JSON/非文件请求体上限，默认 50MB。图片识别等转发请求（base64 图片膨胀约 1/3）易触发默认 1MB 限制，需调大；文件上传不受此限（见 MAX_FILE_SIZE）
# DATA_DIR=/app/data

# === 在线充值（易支付 EPay，可选）===
# 用户自助充值积分：1 元 = 10 积分。启用需配置全部四项 + 回调域名可被公网访问。
# PAY_ON_RECHARGE=1                    # 是否启用在线充值（1=启用，0=手动收款）
# PAY_NOTIFY_BASE=https://your-domain.com  # 回调公网域名，支付结果通知地址为 {该域名}/v1/payment/notify
# EPAY_API=https://epay.example.com   # 易支付网关地址（彩虹易支付协议）
# EPAY_PID=1234                       # 易支付商户 ID(PID)
# EPAY_KEY=your-epay-merchant-key     # 易支付商户密钥(KEY)，请妥善保管
